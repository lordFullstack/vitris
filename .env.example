# Solo nombres — sin valores. No pegar claves acá ni en ningún archivo
# versionado (AC-08-08). Los valores reales viven en .env.local (gitignored)
# y en las variables de entorno de Vercel.

# Panel de proyecto de Supabase > Project Settings > API.
# Pública a propósito: la lee el navegador, RLS es lo que la protege.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La service_role key NUNCA va acá ni en ningún archivo del repo — no lleva
# prefijo NEXT_PUBLIC_ ni se usa desde la app. Las cuentas de comercio se
# crean a mano desde el dashboard de Supabase, no con esta clave.
